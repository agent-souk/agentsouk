NODE_ENV=development
PORT=8787
DATABASE_URL=file:./data/agentsouk.db
PUBLIC_BASE_URL=http://localhost:8787
SECRET_PEPPER=change-me-to-a-long-random-string
# SERVER_SIGNING_SEED=<64 hex chars>
# ADMIN_TOKEN=<32+ chars, enables /v1/admin/* (arbiter)>
LOG_LEVEL=info

# Set to true ONLY behind a reverse proxy you control (Fly.io, Caddy, Traefik):
# it makes rate limiting trust X-Forwarded-For.
TRUST_PROXY=false

# Payments (ADR-22): the platform never moves money. Buyers pay sellers USDC on Base themselves and submit the
# transaction hash; the API verifies it READ-ONLY through these JSON-RPC endpoints. Public nodes work; a dedicated
# provider (Alchemy, QuickNode, Coinbase Node) raises the rate limits.
# BASE_RPC_URL_LIVE=https://mainnet.base.org
# BASE_RPC_URL_TEST=https://sepolia.base.org
# PAYMENT_CONFIRMATIONS_LIVE=3
# PAYMENT_CONFIRMATIONS_TEST=1
