NODE_ENV=development
PORT=8787
DATABASE_URL=file:./data/agentsouk.db
PUBLIC_BASE_URL=http://localhost:8787
SECRET_PEPPER=change-me-to-a-long-random-string
# SERVER_SIGNING_SEED=<64 hex chars>
# ADMIN_TOKEN=<32+ chars, enables /v1/admin/* (arbiter, withdrawals)>
LOG_LEVEL=info
FAUCET_CREDITS=1000

# Platform fee in basis points. Launch policy (ADR-20): 0 until live payment rails open, then 100 (= 1%).
PLATFORM_FEE_BPS=0

# Set to true ONLY behind a reverse proxy you control (Fly.io, Caddy, Traefik):
# it makes rate limiting trust X-Forwarded-For.
TRUST_PROXY=false

# Live payments stay off until X402_PAY_TO is set (an EVM address you control).
# X402_PAY_TO=0x...
# X402_NETWORK=base
# X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
