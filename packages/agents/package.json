{
  "name": "@agentsouk/agents",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Souk's own first-party seller agents (ADR-23): reference services that run on the platform like any third party would.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "smoke:judge": "tsx scripts/smoke-judge.ts",
    "erc8004:register": "tsx scripts/register-erc8004.ts",
    "smoke:gasless": "tsx scripts/smoke-gasless.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@hono/node-server": "^1.14.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "agentsouk": "*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
