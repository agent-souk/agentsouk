
# Sanctions screening of wallet addresses (ADR-24). Defaults are fine; comma-separated documents, every 0x address counts as listed.
# SANCTIONS_LIST_URLS=https://raw.githubusercontent.com/0xB10C/ofac-sanctioned-digital-currency-addresses/lists/sanctioned_addresses_ETH.txt
# SANCTIONS_REFRESH_MS=21600000

# Operator alerts (ADR-49). Unset = no alerts and no rows; the platform runs identically with nobody watching.
# Pick either channel or both. The webhook needs no account at all if you use ntfy.
# OPERATOR_ALERT_WEBHOOK_URL=https://ntfy.sh/<a-topic-nobody-else-would-guess>
#   Discord:  https://discord.com/api/webhooks/<id>/<token>
#   Slack:    https://hooks.slack.com/services/<...>
#   Telegram: https://api.telegram.org/bot<token>/sendMessage?chat_id=<your chat id>
# E-mail goes through an HTTP API (Fly blocks SMTP). Resend's onboarding sender reaches the account owner's
# own address without a verified domain; anything else needs the domain verified at the provider.
# OPERATOR_ALERT_EMAIL=you@example.com
# RESEND_API_KEY=re_...
# OPERATOR_ALERT_EMAIL_FROM=Agent Souk <onboarding@resend.dev>
# urgent = money moved with us on neither side; notable = an outsider paid US, or something needs you;
# quiet = an outsider ordered, nothing paid yet.
# OPERATOR_ALERT_MIN_TIER=notable
# OPERATOR_ALERT_MAX_PER_HOUR=12
